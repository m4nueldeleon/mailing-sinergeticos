# ─────────────────────────────────────────────────────────────
# mailing.sinergeticos.com — variables de entorno
# Copia este archivo a .env.local y pide los valores en privado.
# NUNCA subas .env.local al repo (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────

# Resend — pedir una API key NUEVA creada solo para esta app (se revoca sin afectar a Axis)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Remitente para masivos. Recomendado: subdominio propio de marketing, NO envios.sinergeticos.com
# (ese lo usa Axis para transaccionales; conviene no mezclar reputación). Ver docs/07.
MAIL_FROM="Sinergéticos <hola@boletin.sinergeticos.com>"
MAIL_REPLY_TO=contacto@sinergeticos.com

# Secreto del webhook de Resend (lo genera Resend al registrar https://mailing.sinergeticos.com/api/hooks/resend)
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Base de AXIS — SOLO LECTURA (rol de Postgres de solo lectura que crea el equipo de Axis)
# Se usa para leer contacts / memberships / purchases / touchpoints / mail_supresion.
AXIS_DATABASE_URL_RO=postgresql://usuario_ro:password@host:5432/postgres?sslmode=require

# Base PROPIA de la app de mailing (campañas, listas, segmentos, envíos, eventos)
DATABASE_URL=postgresql://...
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Firma de las ligas de baja (HMAC). Genera uno largo y aleatorio: openssl rand -hex 32
UNSUBSCRIBE_SECRET=

# Interruptores de seguridad (arranca todo apagado, igual que en Axis)
MAIL_ENABLED=false
MAIL_DAILY_CAP=1000

# URL pública de la app (para ligas de baja, pixel de apertura, etc.)
NEXT_PUBLIC_APP_URL=https://mailing.sinergeticos.com
